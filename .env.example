# Публичный HTTPS-адрес API без пути. Для локальной проверки укажите адрес туннеля.
LIDRADAR_PUBLIC_BASE_URL=https://lidradar.example

# Публичные origin веб-клиента (схема и хост, без пути), через запятую. TLS
# завершается на прокси, API видит http и не узнаёт свой origin по схеме, поэтому
# в staging и production без этого списка api не запускается: иначе каждая
# мутация браузера, включая вход, получила бы 403 ORIGIN_NOT_ALLOWED.
LIDRADAR_ALLOWED_ORIGINS=https://lidradar.example

# Узлы, которые завершают TLS перед API: адреса и сети через запятую (например,
# сеть Docker, где работает proxy). Только от них API принимает X-Forwarded-For и
# берёт из него адрес клиента для пределов частоты, сеансов и журнала входа; от
# остальных узлов заголовок игнорируется. Без списка все клиенты за proxy делят
# один адрес (20 входов в минуту и 5 регистраций в час на всех), поэтому в
# staging и production api без него не запускается. В список входят только proxy,
# не сети клиентов; 0.0.0.0/0 отвергается. Подробности: docs/runbooks/proxy-deployment.md
LIDRADAR_TRUSTED_PROXIES=172.16.0.0/12

# Отдельный 32-байтовый ключ для шифрования реквизитов интеграций.
# Сгенерировать: openssl rand -base64 32
LIDRADAR_INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# PostgreSQL в staging и production: LIDRADAR_DATABASE_URL обязан требовать TLS
# (sslmode=require, verify-ca или verify-full), иначе процессы с базой не
# стартуют. Открытый канал допускается только осознанно, для закрытой сети того
# же хоста: LIDRADAR_DATABASE_ALLOW_PLAINTEXT=true. В Compose адрес базы задан
# в compose.yaml (development), здесь он не нужен.

# Локальный помощник подключения и worker уведомлений читают эту переменную.
# Значение не должно попадать в журналы, команды диагностики или снимки экрана.
# Прежнее имя LIDAR_TELEGRAM_TOKEN по-прежнему принимается, новое имеет приоритет.
LIDRADAR_TELEGRAM_TOKEN=replace-with-telegram-bot-token

# Публичное имя бота без символа @. Оно используется только для ссылки /start.
LIDRADAR_TELEGRAM_BOT_USERNAME=LidRadarDevBot

# Cloud Core URL домашнего AI-узла. В staging/production разрешён только HTTPS.
LIDRADAR_AI_CLOUD_URL=https://lidradar.example

# Локальный root-readable файл, созданный командой ai-node-register.
# Сам node_secret в .env не хранится.
LIDRADAR_AI_CREDENTIALS_HOST_FILE=/srv/lidradar/config/ai-node.json

# Зафиксированная на этапе 15 модель. Одинаковая версия задаётся Cloud Core и
# домашнему агенту: узел не получает задание, предназначенное другой модели.
LIDRADAR_AI_MODEL_VERSION=lidradar-main-v1
LIDRADAR_AI_MODEL_FILE=Qwen3-8B-Q4_K_M.gguf
LIDRADAR_AI_MODELS_DIR=/srv/lidradar/models
