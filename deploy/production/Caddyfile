# Edge-прокси LidRadar (ADR 0050): TLS, маршрутизация API и статики, адрес клиента.
#
# Caddy стоит первым на пути запроса и не получает заголовков от вышестоящего
# proxy (trusted_proxies не задан), поэтому переписывает присланные клиентом
# X-Forwarded-For и X-Forwarded-Proto: API видит адрес клиента как последнюю
# запись цепочки (ADR 0049). Если перед Caddy появится CDN или балансировщик,
# добавьте его сети в trusted_proxies и в LIDRADAR_TRUSTED_PROXIES.
{
	email {$LIDRADAR_ACME_EMAIL}
	# HTTP/3 отключён: UDP-порт не публикуется.
	servers {
		protocols h1 h2
	}
}

{$LIDRADAR_DOMAIN} {
	header {
		-Server
		# По умолчанию: API отдаёт свой HSTS сам, веб-клиент (nginx) нет.
		?Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# API веб-клиента и вебхуки провайдеров. flush_interval -1 нужен потоку событий
	# (SSE): без него события копились бы в буфере proxy. Сжатие здесь не включается:
	# оно буферизует поток.
	@api path /api/*
	handle @api {
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# API домашнего AI-узла: узел сам ходит к API (входящих портов дома нет). Узел и без
	# этого проходит секрет, подпись запроса и допуск организаций; список адресов
	# LIDRADAR_AI_NODE_ALLOWED_IPS (адреса или CIDR через пробел) закрывает путь от остальных
	# адресов ещё на краю. По умолчанию открыто любому адресу, чтобы выпуск без домашнего
	# узла и смена его адреса не требовали правки файла; рекомендуется задать статичный
	# адрес узла (ADR 0050, уточнение 2026-10-15).
	@ainode path /internal/v1/ai/*
	handle @ainode {
		@ainode_denied {
			not remote_ip {$LIDRADAR_AI_NODE_ALLOWED_IPS:0.0.0.0/0 ::/0}
		}
		respond @ainode_denied "forbidden" 403
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	# Снаружи доступна только живость. /health/ready раскрывает ревизию сборки и
	# версии миграций, его читают проверки контейнера и scripts/smoke-production.sh.
	handle /health/live {
		reverse_proxy api:8080
	}
	handle /health/* {
		respond "not found" 404
	}

	# Всё остальное — статика веб-клиента (SPA с переходом на index.html).
	handle {
		encode zstd gzip
		reverse_proxy web:8080
	}
}
