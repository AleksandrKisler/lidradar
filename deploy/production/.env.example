# Настройки production-стека LidRadar (ADR 0050, docs/runbooks/production-deployment.md).
# Скопируйте в .env рядом с compose.yaml, заполните и закройте от других
# пользователей: chmod 600 .env. Файл .env в git не попадает.

# --- Выпуск ---------------------------------------------------------------
# Тег образов lidradar-*:<тег>, который напечатал scripts/build-images.sh
# (первые 12 символов git sha). /health/ready показывает ту же версию.
LIDRADAR_VERSION=
# production или staging. Для staging используйте отдельный хост или проект,
# отдельный домен и отдельные данные: клиентских сообщений в staging нет.
LIDRADAR_ENV=production

# --- Адрес ----------------------------------------------------------------
# Публичное доменное имя. DNS A/AAAA должны указывать на этот хост, порты 80 и
# 443 открыты в брандмауэре: так Caddy выпускает и продлевает сертификат.
LIDRADAR_DOMAIN=app.example.com
# Почта для уведомлений центра сертификации.
LIDRADAR_ACME_EMAIL=ops@example.com
# Публичный origin, если он не https://<LIDRADAR_DOMAIN> (например, нестандартный порт).
# LIDRADAR_PUBLIC_ORIGIN=https://app.example.com

# --- PostgreSQL (ADR 0052) --------------------------------------------------
# Встроенная база работает под тремя учётными записями; пароли выбирайте разные,
# войдут в строки подключения, поэтому только символы, безопасные в URL:
#   openssl rand -hex 24
# Администратор postgres: пароль нужен образу при создании тома. По сети администратор
# не входит (pg_hba.conf), процессам приложения пароль не передаётся.
POSTGRES_PASSWORD=
# Владелец базы lidradar (не суперпользователь): миграции (migrate), восстановление.
LIDRADAR_DB_OWNER_PASSWORD=
# Рабочий логин lidradar_runtime (не владелец): api, worker, scheduler, копии, инструменты.
LIDRADAR_DB_RUNTIME_PASSWORD=
# База в контейнере во внутренней сети хоста доступна без TLS. Это осознанное
# решение (ADR 0049/0050); для внешней базы задайте строки подключения ниже с
# sslmode=verify-full и оставьте здесь false.
LIDRADAR_DATABASE_ALLOW_PLAINTEXT=true
# Внешняя база: рабочий логин для api, worker, scheduler, копий и инструментов и владелец
# для migrate. Роли создаёт администратор базы файлом postgres/10-roles.sql. Значения
# паролей выше compose всё равно требует (любые непустые), пока встроенный postgres не отключён.
# LIDRADAR_DATABASE_URL=postgres://lidradar_runtime:password@db.example.com:5432/lidradar?sslmode=verify-full
# LIDRADAR_MIGRATE_DATABASE_URL=postgres://lidradar:password@db.example.com:5432/lidradar?sslmode=verify-full

# --- Telegram -------------------------------------------------------------
# Ключ шифрования токенов каналов: openssl rand -base64 32. Потеря ключа делает
# сохранённые токены нечитаемыми: храните копию отдельно от копий базы.
LIDRADAR_INTEGRATION_ENCRYPTION_KEY=
# Бот уведомлений владельцам (worker) и его публичное имя без @ (ссылка /start).
LIDRADAR_TELEGRAM_TOKEN=
LIDRADAR_TELEGRAM_BOT_USERNAME=

# --- Копии вне хоста (ADR 0051, docs/runbooks/offhost-backup.md) -----------
# Обязательны: без них стек не запустится. Копия шифруется публичным ключом age и
# уходит в S3-совместимое хранилище; приватный ключ на хост не кладут.
# Хранилище для rclone: имя offhost и путь бакет/префикс, например offhost:lidradar-backups/prod
LIDRADAR_BACKUP_REMOTE=
# Адрес, регион и ключ доступа выдаёт поставщик. Ключу нужны только запись и чтение
# объектов (без перечня и удаления).
LIDRADAR_BACKUP_S3_ENDPOINT=
LIDRADAR_BACKUP_S3_ACCESS_KEY_ID=
LIDRADAR_BACKUP_S3_SECRET_ACCESS_KEY=
# Публичные ключи получателей age1…, через запятую: age-keygen на компьютере оператора,
# не меньше двух хранителей. Потеря всех приватных ключей делает копии нечитаемыми.
LIDRADAR_BACKUP_AGE_RECIPIENTS=

# --- Необязательное -------------------------------------------------------
# LIDRADAR_NOTIFICATIONS_OWNER_ESCALATION=false
# LIDRADAR_NOTIFICATIONS_OWNER_ESCALATION_AFTER=30m
# LIDRADAR_AI_MODEL_VERSION=lidradar-main-v1
# LIDRADAR_HTTP_RATE_LIMIT_PER_MINUTE=120
# LIDRADAR_HTTP_WEBHOOK_RATE_LIMIT_PER_MINUTE=1200
# LIDRADAR_HTTP_AI_NODE_RATE_LIMIT_PER_MINUTE=600
# Подсеть edge, закреплённый адрес Caddy внутри неё и пул адресов для остальных
# контейнеров (он не должен содержать адрес Caddy). Меняйте вместе, если подсеть
# пересекается с сетями хоста.
# LIDRADAR_EDGE_SUBNET=172.29.88.0/24
# LIDRADAR_EDGE_IP=172.29.88.2
# LIDRADAR_EDGE_DYNAMIC_RANGE=172.29.88.128/25
# Порты на хосте (по умолчанию 80 и 443; для ACME нужны именно они).
# LIDRADAR_HTTP_PORT=80
# LIDRADAR_HTTPS_PORT=443
# Пределы памяти контейнеров.
# LIDRADAR_API_MEMORY=512m
# LIDRADAR_WORKER_MEMORY=512m
# LIDRADAR_SCHEDULER_MEMORY=128m
# LIDRADAR_POSTGRES_MEMORY=1g
# LIDRADAR_TOOLS_MEMORY=128m
# Копии вне хоста: расписание и мониторинг.
# LIDRADAR_BACKUP_INTERVAL=10m
# LIDRADAR_BACKUP_MAX_AGE=15m
# Сигналы внешнему мониторингу (healthchecks.io и подобные): после каждой подтверждённой
# копии и после сбоя. Адреса содержат секрет.
# LIDRADAR_BACKUP_PING_URL=
# LIDRADAR_BACKUP_FAIL_URL=
# LIDRADAR_BACKUP_S3_PROVIDER=Other
# LIDRADAR_BACKUP_S3_REGION=
# Своя строка подключения для копий (по умолчанию как у приложения).
# LIDRADAR_BACKUP_DATABASE_URL=
# LIDRADAR_BACKUP_MEMORY=256m
